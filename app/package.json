{
  "name": "beecube",
  "version": "0.1.0",
  "description": "BeeCube: make 3D games and animations with blocks",
  "scripts": {
    "predev": "node scripts/copy-media.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-media.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "bench": "vitest run --config vitest.bench.config.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "scratch-blocks": "^2.1.34",
    "scratch-l10n": "4.0.46",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.4",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.1"
  },
  "private": true
}
